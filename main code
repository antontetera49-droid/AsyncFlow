#AsyncFlow: High-performance, concurrent asynchronous rate-limiter and batch processor 
#designed for developer pipelines, API consumption, and data sync tasks.

import asyncio
import time
import logging
from typing import Callable, List, Any, Coroutine

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
logger = logging.getLogger("AsyncFlow")

class AsyncFlowEngine:
    def init(self, max_concurrent: int = 10, rate_limit_delay: float = 0.1):
        self.max_concurrent = max_concurrent
        self.rate_limit_delay = rate_limit_delay
        self.semaphore = asyncio.Semaphore(max_concurrent)

    async def _execute_with_limit(self, coro_func: Callable[..., Coroutine], *args: Any, **kwargs: Any) -> Any:
        async with self.semaphore:
            try:
                result = await coro_func(*args, **kwargs)
                return result
            except Exception as e:
                logger.error(f"Execution failed: {e}")
                raise
            finally:
                if self.rate_limit_delay > 0:
                    await asyncio.sleep(self.rate_limit_delay)

    async def run_batch(self, tasks: List[Callable[..., Coroutine]]) -> List[Any]:
        logger.info(f"Starting batch execution of {len(tasks)} tasks with max_concurrent={self.max_concurrent}")
        wrapped_tasks = [self._execute_with_limit(task) for task in tasks]
        results = await asyncio.gather(*wrapped_tasks, return_exceptions=True)
        logger.info("Batch execution completed.")
        return results

async def sample_worker(task_id: int):
    await asyncio.sleep(0.2)
    return f"Task {task_id} completed successfully"

async def main():
    engine = AsyncFlowEngine(max_concurrent=5, rate_limit_delay=0.05)
    tasks = [lambda i=i: sample_worker(i) for i in range(15)]
    results = await engine.run_batch(tasks)
    print("Execution Results:", results)

if __name__ == "__main__":
    asyncio.run(main())


